# Checks that find bugs, not style. Run: cmake --build build --target lint
# Left out as noise here: signed bitwise ops (SWELL's flags), assignments in conditions and identical
# switch branches (idioms used on purpose), exceptions (we don't use them), enum sizes, rand() and its fixed seed in tests,
# narrowing (-Wconversion covers it), SWELL's integer-to-pointer casts, and REAPER's LICE__ API names.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -bugprone-signed-bitwise,
  -bugprone-assignment-in-if-condition,
  -bugprone-assignment-in-selection-statement,
  -bugprone-branch-clone,
  -bugprone-exception-escape,
  -bugprone-throwing-static-initialization,
  -bugprone-switch-missing-default-case,
  -bugprone-unhandled-code-paths,
  -bugprone-random-generator-seed,
  -bugprone-reserved-identifier,
  clang-analyzer-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -clang-analyzer-security.insecureAPI.rand,
  -clang-analyzer-optin.performance.Padding,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  cppcoreguidelines-init-variables,
  cppcoreguidelines-pro-type-member-init,
  misc-redundant-expression,
  misc-misplaced-const,
  readability-misleading-indentation
HeaderFilterRegex: '.*/(src|tests)/.*'
WarningsAsErrors: ''
